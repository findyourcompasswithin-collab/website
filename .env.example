# ──────────────────────────────────────────────────────────────────────────────
# FIND YOUR COMPASS WITHIN — Environment Variables
# Copy this file to .env.local for local development.
# Add all of these in Vercel → Project Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────────────────────

# ── PAYFAST ──────────────────────────────────────────────────────────────────
# Get these from your Payfast merchant dashboard: payfast.io/merchant/settings
PAYFAST_MERCHANT_ID=your_merchant_id_here
PAYFAST_MERCHANT_KEY=your_merchant_key_here
PAYFAST_PASSPHRASE=your_passphrase_here

# Set to "true" for sandbox testing, "false" for live payments
PAYFAST_SANDBOX=true

# ── SUPABASE ─────────────────────────────────────────────────────────────────
# Get these from your Supabase project: supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the SERVICE ROLE key (not the anon key) — this is server-side only
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── RESEND (Email delivery) ───────────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=re_your_key_here

# The email address that sends delivery emails — must be verified in Resend
# e.g. melcooper@findyourcompasswithin.com
FROM_EMAIL=melcooper@findyourcompasswithin.com
FROM_NAME=Find Your Compass Within

# ── SITE ─────────────────────────────────────────────────────────────────────
# Your live site URL (no trailing slash)
SITE_URL=https://findyourcompasswithin.com
